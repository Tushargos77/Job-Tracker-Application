# Copy this file to .env and fill in the values.

# PostgreSQL connection string. Leave empty to use a local SQLite file (jobtracker.db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobtracker

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated list of frontend origins allowed to call the API.
# Use * to allow any origin (not recommended in production).
ALLOWED_ORIGINS=http://localhost:5173
